{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/api/blog-page"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-page?slug=:slug"
    },
    {
      "source": "/careers",
      "destination": "/careers/index.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/demo/index.html",
      "destination": "/demo/index.html"
    },
    {
      "source": "/login",
      "destination": "/login/index.html"
    },
    {
      "source": "/signup",
      "destination": "/signup/index.html"
    },
    {
      "source": "/forgot",
      "destination": "/forgot/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/reset-password/index.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/how-it-works/index.html"
    },
    {
      "source": "/integrations",
      "destination": "/integrations/index.html"
    },
    {
      "source": "/use-cases/handover",
      "destination": "/use-cases/handover/index.html"
    },
    {
      "source": "/use-cases/decisions",
      "destination": "/use-cases/decisions/index.html"
    },
    {
      "source": "/use-cases/workday-planner",
      "destination": "/use-cases/workday-planner/index.html"
    },
    {
      "source": "/for-individuals",
      "destination": "/for-individuals/index.html"
    },
    {
      "source": "/for-founders",
      "destination": "/for-founders/index.html"
    },
    {
      "source": "/for-companies",
      "destination": "/for-companies/index.html"
    },
    {
      "source": "/tour",
      "destination": "/tour/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/competition-terms",
      "destination": "/competition-terms/index.html"
    },
    {
      "source": "/llms.txt",
      "destination": "/llms.txt"
    },
    {
      "source": "/walkthrough/:path*",
      "destination": "/walkthrough/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/templates/:path*",
      "destination": "/templates/:path*"
    },
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "destination": "/.well-known/microsoft-identity-association.json"
    },
    {
      "source": "/api/capture/callback",
      "destination": "/api/capture/callback"
    },
    {
      "source": "/api/calendar",
      "destination": "/api/calendar"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tour",
      "destination": "/#product-demo",
      "statusCode": 307
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vimbre.co.uk"
        }
      ],
      "destination": "https://vimbre.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vimbre.co.uk"
        }
      ],
      "destination": "https://vimbre.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vimbre.vercel.app"
        }
      ],
      "destination": "https://vimbre.com/:path*",
      "statusCode": 307
    }
  ],
  "functions": {
    "api/blog-page.mjs": {
      "includeFiles": "api/generated/blog-shell.html"
    },
    "api/sitemap.mjs": {
      "includeFiles": "api/generated/sitemap-base.json"
    }
  }
}
