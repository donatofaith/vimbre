{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "destination": "/.well-known/microsoft-identity-association.json"
    },
    {
      "source": "/api/capture/callback",
      "destination": "/api/capture/callback"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "vimbre.co.uk"
        }
      ],
      "destination": "https://vimbre.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.vimbre.co.uk"
        }
      ],
      "destination": "https://vimbre.com/:path*",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/.well-known/microsoft-identity-association.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        }
      ]
    }
  ]
}
