{
  "name": "vimbre",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run typecheck:ai && npm run build",
    "test:browser": "node scripts/check-landing-browser.cjs && node scripts/check-chat-browser.cjs && node scripts/check-browser.cjs && node scripts/check-team-browser.cjs && node scripts/check-records-browser.cjs && node scripts/check-actions-browser.cjs && node scripts/check-capture-browser.cjs && node scripts/check-ai-browser.cjs",
    "test:landing": "node scripts/check-landing-browser.cjs",
    "typecheck:ai": "tsc -p scripts/tsconfig.ai.json"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@supabase/supabase-js": "2.118.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "motion": "12.23.24"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
